---
import '../styles/global.css';
import { NAV_ITEMS, routesFromFiles, visibleItems } from '../navigation.mjs';

// Works for .astro pages (title prop) and .mdx pages (frontmatter title).
const { frontmatter, title: titleProp } = Astro.props;
const title = titleProp ?? frontmatter?.title ?? 'Portfolio';
const routes = routesFromFiles(Object.keys(import.meta.glob('/src/pages/**/*.{astro,mdx,md}')));
const nav = visibleItems(NAV_ITEMS, routes);
const contact = nav.find((i) => i.label === 'Contact');
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <header class="site-header">
      <div class="frame">
        <nav class="site-nav" aria-label="Main">
          <ul>
            {nav.map((i) => <li><a href={i.href}>{i.label}</a></li>)}
          </ul>
        </nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="frame">
        <span>Portfolio</span>
        {contact && <a href={contact.href}>Get in touch</a>}
      </div>
    </footer>
  </body>
</html>
